# Скопируйте в .env рядом с wsgi.py — файл подхватывается при запуске. .env не коммитить.

# База данных. Пусто — SQLite в папке instance/ (локально и на виртуальном хостинге вроде Sprinthost).
# На Render/Railway обязательно Postgres, иначе данные пропадут при редеплое.
DATABASE_URL=

# Первый администратор (создаётся/получает права при запуске). Логин может быть email.
ADMIN_LOGIN=admin@example.com
ADMIN_PASSWORD=change-me-please

# Публичный адрес кабинета (для ссылок-приглашений, /go/... и вебхука Telegram).
# Если кабинет в подпапке сайта — вместе с подпапкой.
PUBLIC_URL=https://your-domain.com
# Кабинет в подпапке сайта, например /secretniyadresstest (пусто — в корне домена)
URL_PREFIX=

# Telegram-бот: коды подтверждения при регистрации и уведомления. Без него регистрация не работает.
# Локально (без https в PUBLIC_URL) бот сам забирает сообщения, на хостинге с https — вебхук.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# 1 — заполнить пустую базу демо-данными при первом запуске
SEED_DEMO=0
