# База данных. Пусто — SQLite в папке instance/ (только для локального запуска).
# На хостинге обязательно Postgres, иначе данные пропадут при редеплое.
DATABASE_URL=

# Первый администратор (создаётся/получает права при запуске)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# Публичный адрес сайта (для ссылок /go/... и вебхука Telegram)
PUBLIC_URL=https://your-domain.com

# Необязательно: уведомления в Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# 1 — заполнить пустую базу демо-данными при первом запуске
SEED_DEMO=0
